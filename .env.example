# Host port exposed by Docker.
CARFREEKS_PORT=8060
# Publishes on the host's network interfaces for LAN access.
# Restrict this port to your LAN with the host firewall.
CARFREEKS_BIND_ADDRESS=0.0.0.0
CARFREEKS_NOTIFICATION_INTERVAL_SECONDS=300

# Set to true when HTTPS is terminated by a reverse proxy.
CARFREEKS_COOKIE_SECURE=false
