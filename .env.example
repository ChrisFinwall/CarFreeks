# Generate with: openssl rand -hex 32
CARFREEKS_SECRET_KEY=replace-with-a-random-secret-at-least-32-characters
CARFREEKS_ADMIN_USERNAME=owner
CARFREEKS_ADMIN_PASSWORD=replace-with-a-unique-password-at-least-12-characters
CARFREEKS_PORT=8080

# Set to true when HTTPS is terminated by a reverse proxy.
CARFREEKS_COOKIE_SECURE=false
